{
  "manifest_version": 3,
  "name": "winuse",
  "version": "0.1.3",
  "description": "Lets winuse drive this browser's pages, with your logins, through chrome.debugger. Agent tabs open in the background. Click the icon to turn it off.",
  "key": "",
  "minimum_chrome_version": "125",
  "permissions": ["debugger", "tabs", "tabGroups", "nativeMessaging", "alarms", "storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "winuse" }
}
